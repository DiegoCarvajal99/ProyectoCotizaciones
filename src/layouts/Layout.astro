---
import '../styles/global.css';
import { AuthWrapper } from '../components/auth/AuthWrapper';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	requireAdmin?: boolean;
}

const { title, requireAdmin = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="MT System - Control Terminal" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
		
		<title>{title} | MT System</title>
		<ClientRouter />
	</head>
	<body class="bg-[#0A0A0B] text-white overflow-hidden">
		<AuthWrapper 
			key={currentPath}
			requireAdmin={requireAdmin} 
			currentPath={currentPath} 
			title={title} 
			client:only="react"
		>
			<slot />
		</AuthWrapper>
	</body>
</html>

<style is:global>
	:root {
		--accent: 0, 163, 224;
		--accent-light: 120, 210, 255;
		--accent-dark: 0, 80, 150;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	
	html {
		font-family: 'Inter', system-ui, sans-serif;
		background: #0A0A0B;
	}

	.font-mono {
		font-family: 'JetBrains Mono', monospace;
	}

	.glass-panel {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	.text-shadow-neon {
		text-shadow: 0 0 10px rgba(0, 163, 224, 0.5), 0 0 20px rgba(0, 163, 224, 0.2);
	}

	.custom-scrollbar::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}

	.custom-scrollbar::-webkit-scrollbar-track {
		background: transparent;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: rgba(0, 163, 224, 0.2);
		border-radius: 10px;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 163, 224, 0.4);
	}
</style>
